# CrowdSafe AI — Environment Variables Template
# Copy this file to .env and fill in your credentials.
# The system works fully without these (notifications will be simulated).

# ── Twilio SMS (optional) ──────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM=+1234567890
ALERT_PHONES=+919876543210,+919876543211

# ── Email SMTP (optional) ──────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
ALERT_EMAILS=security@venue.com,admin@venue.com

# ── Webhook (optional — POST on every alert) ──────────────────────────────
WEBHOOK_URL=https://your-command-center.com/webhook/crowd-alert

# ── Weather API (optional) ────────────────────────────────────────────────
OPENWEATHER_API_KEY=your_key_here

# —— Inference performance (optional) ———————————————————————————————
# auto picks CUDA when available, otherwise CPU
YOLO_DEVICE=auto
# Smaller size = faster inference (typical: 512 / 640 / 768)
YOLO_IMGSZ=640
# Detection threshold (lower = more detections, more false positives)
YOLO_CONFIDENCE=0.25
# IoU threshold for NMS post-processing
YOLO_IOU_THRESHOLD=0.45
# Person class IDs. Keep 0 for default COCO model. Set empty to disable class filtering.
YOLO_CLASSES=0
# Run detector every N frames (1 = every frame, recommended for accuracy)
YOLO_FRAME_STRIDE=1
# Use FP16 on CUDA for better throughput
YOLO_USE_HALF=true
# Face blur is CPU-heavy; keep false for max performance
PRIVACY_BLUR_FACES=false
# Track confirmation frames (1 = immediate ID assignment)
TRACKER_MIN_HITS=1
